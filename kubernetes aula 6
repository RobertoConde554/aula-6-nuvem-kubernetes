apiVersion: v1
kind: ConfigMap
metadata:
  name: pagina-aula6
data:
  index.html: |
    <h1>Aula 6 - Computacao em Nuvem</h1>
    <p>Pagina carregada por ConfigMap</p>



apiVersion: v1
kind: Pod
metadata:
  name: web-config
spec:
  containers:
    - name: nginx
      image: nginx:alpine
      volumeMounts:
        - name: pagina
          mountPath: /usr/share/nginx/html
  volumes:
    - name: pagina
      configMap:
        name: pagina-aula6


apiVersion: v1
kind: PersistentVolume
metadata:
  name: pv-aula6
spec:
  capacity:
    storage: 100Mi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: manual
  hostPath:
    path: /mnt/data-aula6



apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: pvc-aula6
spec:
  storageClassName: manual
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 50Mi


apiVersion: v1
kind: Pod
metadata:
  name: pod-dados
spec:
  containers:
    - name: app
      image: busybox:1.36
      command: ['sh', '-c', 'sleep 3600']
      volumeMounts:
        - name: dados
          mountPath: /dados
  volumes:
    - name: dados
      persistentVolumeClaim:
        claimName: pvc-aula6





